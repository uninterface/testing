{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/package/types",
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.mjs", "src/**/*.mts", "src/**/*.vue"]
}
